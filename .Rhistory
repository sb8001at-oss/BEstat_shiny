normality_test <- function(pkparam){
names_param <- c("AUC", "AUCinf", "Cmax", "tmax", "kel", "thalf", "MRT", "MRTinf")
out <- list()
for(i in 1:8){
tname <- names_param[i]
if(tname == "tmax"){
out[[i]] <- pkparam[, tname] |> shapiro.test() |> broom::tidy()
} else {
out[[i]] <- pkparam[, tname] |> log() |> shapiro.test() |> broom::tidy()
}
}
return(out[[i]])
}
